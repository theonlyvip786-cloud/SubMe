# ────────────────────────────────────────────────────────────────
# SubKo Backend — Environment Configuration
# Copy this to .env and fill in your values.
# ────────────────────────────────────────────────────────────────

# Supabase project connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role key from Supabase dashboard

# JWT secret — used to sign the admin HS256 token.
# For Supabase user tokens (ES256), the backend falls back to
# remote verification via supabase.auth.getUser().
SUPABASE_JWT_SECRET=
JWT_SECRET=                    # fallback if SUPABASE_JWT_SECRET is empty

# Admin credentials (required)
ADMIN_EMAIL=admin@subko.app    # the canonical admin address
ADMIN_PASSWORD=changeme       # STRONG password — this IS the admin account
# ADMIN_EMAILS=                # optional: comma-separated extra admin addresses

# Server
PORT=5000                      # must match mobile-app config.ts in dev
CORS_ORIGIN=*                  # set to your domain in production, e.g. https://subko.app
TRUST_PROXY=0                  # set to "1" when behind Render/Railway/Nginx
